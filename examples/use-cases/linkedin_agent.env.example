# LinkedIn AI Agent — Environment Variables
# Copy this file to .env and fill in your values.

# ── LLM Provider (pick one) ──────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ── Browser ───────────────────────────────────────────────────────────────────
# Path to your Chrome or Chromium binary.
# The agent connects to your existing logged-in browser session.
# macOS:
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux:
# CHROME_PATH=/usr/bin/google-chrome
# Windows:
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# (Optional) Path to a Playwright cookies JSON file for auth instead of chrome_instance_path.
# Export your LinkedIn cookies with: https://github.com/rotemweiss57/gpt-marketer
# LINKEDIN_COOKIES_FILE=./linkedin_cookies.json

# ── Your LinkedIn Identity ────────────────────────────────────────────────────
LINKEDIN_NAME=Jane Smith
LINKEDIN_HEADLINE=Helping B2B SaaS founders close more deals with AI | Founder @AcmeCo
LINKEDIN_PROFILE_URL=https://www.linkedin.com/in/janesmith

# ── Outreach Copy ────────────────────────────────────────────────────────────
# Used in message templates (see linkedin_agent.py for full templates)
LINKEDIN_TARGET_PERSONA=B2B SaaS founders and sales leaders
LINKEDIN_VALUE_PROP=close more enterprise deals using AI-powered outreach
